# Copy to .env and fill in. .env is ignored by git.

# PostgreSQL + pgvector from compose.yaml (host port 5433 so it does not clash with job_rag_starter)
POSTGRES_USER=cn_agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cn_job_agent
CN_DATABASE_URL=postgresql+psycopg://cn_agent:change-me@127.0.0.1:5433/cn_job_agent

# The existing job_rag_starter project: its retrieval code and the experiences/ library are reused read-only
CN_JOB_RAG_HOME=E:/CV/job_rag_starter
# Optional: another experiences folder (defaults to <CN_JOB_RAG_HOME>/experiences)
# CN_EXPERIENCES_DIR=

# Personal search profile (roles, cities, channels, testamur month); see profile.example.yaml
CN_PROFILE_PATH=profile.local.yaml

# 1 = use the cached embedding model only, no download
CN_OFFLINE=1

# Language model for JD extraction, evidence judgment and the search planner.
#   local              the local model in <CN_JOB_RAG_HOME>/config.local.json (data stays on this machine)
#   deepseek | qwen | zhipu | moonshot | doubao | siliconflow | openai | anthropic | gemini | openai_compatible
# With a cloud provider, JD text, the search profile and experience excerpts are sent to that provider.
# List them with: cn-agent llm providers     Test with: cn-agent llm check --ping
CN_LLM_PROVIDER=local
# Model name as the provider documents it (required for cloud providers), e.g. CN_LLM_MODEL=deepseek-chat
# CN_LLM_MODEL=
# API key (or the provider's standard variable, e.g. DEEPSEEK_API_KEY, in the environment)
# CN_LLM_API_KEY=
# Only for openai_compatible, or to override a provider's endpoint
# CN_LLM_BASE_URL=
# Optional: json_object | json_schema | none, context window and output tokens
# CN_LLM_RESPONSE_FORMAT=
# CN_LLM_CONTEXT_BUDGET=
# CN_LLM_MAX_OUTPUT_TOKENS=8192

# Chinese base resume JSON for the materials agent: name, contact, education, confirmed skills.
# Name and contact are filled in locally and never sent to the model.
# CN_RESUME_BASE=
